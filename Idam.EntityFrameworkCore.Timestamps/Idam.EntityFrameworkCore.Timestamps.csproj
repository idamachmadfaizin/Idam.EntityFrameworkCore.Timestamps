<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <IncludeSource>true</IncludeSource>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
        <DeterministicSourcePaths>true</DeterministicSourcePaths>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <PackageId>Idam.EntityFrameworkCore.Timestamps</PackageId>
        <Version>10.0.0</Version>
        <Authors>Idam Achmad Faizin</Authors>
        <Copyright>Copyright © Idam Achmad Faizin 2025</Copyright>

        <Description>A .NET library for entity timestamps and softdelete. Easily manage CreatedAt, UpdatedAt, and DeletedAt fields with support for DateTime, UTC DateTime, DateTimeOffset, and Unix time (milliseconds).</Description>
        <PackageTags>Timestamps;Softdelete;CreatedAt;UpdatedAt;DeletedAt;DateTimeOffset;TimeProvider</PackageTags>
        <PackageProjectUrl>https://github.com/idamachmadfaizin/Idam.EntityFrameworkCore.Timestamps</PackageProjectUrl>
        <RepositoryUrl>https://github.com/idamachmadfaizin/Idam.EntityFrameworkCore.Timestamps</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>https://github.com/idamachmadfaizin/Idam.EntityFrameworkCore.Timestamps/blob/main/CHANGELOG.md</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" />
    </ItemGroup>

</Project>
